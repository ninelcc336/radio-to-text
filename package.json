{
  "name": "audio-transcription-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app for audio transcription",
  "main": "app/desktop/main.js",
  "scripts": {
    "dev": "set NODE_ENV=development&& .\\node_modules\\electron\\dist\\electron.exe .",
    "dev:web": "npm --prefix app/desktop/web run dev",
    "build:web": "npm --prefix app/desktop/web run build && node app/desktop/scripts/sync-next-standalone-assets.js",
    "start:web": "npm --prefix app/desktop/web run start",
    "dev:desktop": "set NODE_ENV=development&& .\\node_modules\\electron\\dist\\electron.exe .",
    "start": "set NODE_ENV=production&& .\\node_modules\\electron\\dist\\electron.exe .",
    "smoke": "node app/desktop/scripts/smoke.js",
    "sample": "node app/desktop/scripts/process-sample.js tools/sample-meeting.wav",
    "model:consolidate": "node tools/migrate-model-cache.js",
    "engine:health": "python -X utf8 engine/python/main.py",
    "build:engine:deps": "py -3.12 -m pip install -r requirements-build.txt",
    "build:engine": "py -3.12 -m PyInstaller --noconfirm --clean --distpath dist-python --workpath build\\pyinstaller build\\windows\\engine.spec",
    "build:engine:verify": "node app/desktop/scripts/verify-engine-build.js",
    "dist:clean": "node app/desktop/scripts/clean-dist-output.js",
    "dist:win": "npm run build:web && npm run build:engine && npm run build:engine:verify && node app/desktop/scripts/clean-dist-output.js release/win-unpacked && electron-builder --config.directories.output=release --win nsis portable",
    "dist:portable": "npm run build:web && npm run build:engine && npm run build:engine:verify && npm run dist:clean && electron-builder --win portable",
    "dist:offline:small": "npm run build:web && npm run build:engine && npm run build:engine:verify && node app/desktop/scripts/build-distribution.js",
    "dist:offline:small:verify": "node app/desktop/scripts/verify-offline-distribution.js"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.audio-transcription-assistant",
    "productName": "音频转写助手",
    "electronVersion": "37.2.6",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "!app/desktop/web/.next{,/**/*}",
      "!app/desktop/web/node_modules{,/**/*}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-python/engine",
        "to": "engine"
      },
      {
        "from": "app/desktop/web/.next/standalone",
        "to": "web"
      },
      {
        "from": "app/desktop/web/.next/static",
        "to": "web/.next/static"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "audio-transcription-assistant-${version}-setup.${ext}",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "portable": {
      "artifactName": "audio-transcription-assistant-${version}-portable.${ext}"
    }
  }
}
